{
  "color": {
    "$type": "color",
    "bg": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
    "surface": { "$value": { "colorSpace": "srgb", "components": [0.965, 0.969, 0.976], "hex": "#f6f7f9" } },
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.086, 0.094, 0.114], "hex": "#16181d" } },
    "muted": { "$value": { "colorSpace": "srgb", "components": [0.357, 0.384, 0.439], "hex": "#5b6270" } },
    "line": { "$value": { "colorSpace": "srgb", "components": [0.851, 0.867, 0.890], "hex": "#d9dde3" } },
    "accent": { "$value": { "colorSpace": "srgb", "components": [0.165, 0.329, 0.835], "hex": "#2a54d5" } },
    "on-accent": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
    "success": { "$value": { "colorSpace": "srgb", "components": [0.024, 0.463, 0.278], "hex": "#067647" } },
    "danger": { "$value": { "colorSpace": "srgb", "components": [0.706, 0.137, 0.094], "hex": "#b42318" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 6, "unit": "px" } }
  },
  "font": {
    "body": { "$type": "fontFamily", "$value": ["system-ui", "Segoe UI", "Roboto", "sans-serif"] },
    "size-body": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
    "size-heading": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
    "weight-strong": { "$type": "fontWeight", "$value": 600 }
  }
}
