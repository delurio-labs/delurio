{
  "name": "@delurio/cli",
  "version": "0.14.0",
  "description": "The open checker and page of delurio-graph/0: check every graph in a project's own CI, offline, with GNU error lines and SARIF.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "delurio": "js/cli.js" },
  "exports": {
    "./graph": { "types": "./js/graph.d.ts", "default": "./js/graph.js" },
    "./model": { "types": "./js/model.d.ts", "default": "./js/model.js" },
    "./story": { "types": "./js/story.d.ts", "default": "./js/story.js" },
    "./wireframe": { "types": "./js/wireframe.d.ts", "default": "./js/wireframe.js" },
    "./kit": { "types": "./js/kit.d.ts", "default": "./js/kit.js" },
    "./edges": { "types": "./js/edges.d.ts", "default": "./js/edges.js" },
    "./html": { "types": "./js/html.d.ts", "default": "./js/html.js" },
    "./nav": { "types": "./js/nav.d.ts", "default": "./js/nav.js" },
    "./expr": { "types": "./js/expr.d.ts", "default": "./js/expr.js" },
    "./spine": { "types": "./js/spine.d.ts", "default": "./js/spine.js" },
    "./yaml": { "types": "./js/yaml.d.ts", "default": "./js/yaml.js" },
    "./needs": { "types": "./js/needs.d.ts", "default": "./js/needs.js" },
    "./package.json": "./package.json"
  },
  "files": ["js", "schemas", "SPEC.md", "NOTICE", "CHANGELOG.md"],
  "engines": { "node": ">=26" },
  "repository": { "type": "git", "url": "git+https://github.com/delurio-labs/delurio.git" },
  "homepage": "https://delur.io",
  "bugs": "https://github.com/delurio-labs/delurio/issues",
  "keywords": ["statechart", "graph", "spec", "checker", "sarif", "ci"],
  "napi": {
    "binaryName": "delurio",
    "packageName": "@delurio/cli",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --manifest-path crates/delurio-node/Cargo.toml --package-json-path package.json --output-dir . --no-js --dts js/native.d.cts",
    "build:debug": "napi build --platform --manifest-path crates/delurio-node/Cargo.toml --package-json-path package.json --output-dir . --no-js --dts js/native.d.cts",
    "test": "node --test tests/node/"
  },
  "dependencies": {
    "elkjs": "0.12.1"
  },
  "optionalDependencies": {
    "@delurio/cli-linux-x64-gnu": "0.14.0",
    "@delurio/cli-linux-x64-musl": "0.14.0",
    "@delurio/cli-linux-arm64-gnu": "0.14.0",
    "@delurio/cli-linux-arm64-musl": "0.14.0",
    "@delurio/cli-darwin-arm64": "0.14.0",
    "@delurio/cli-win32-x64-msvc": "0.14.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12"
  }
}
