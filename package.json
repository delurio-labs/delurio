{
  "name": "@delurio/cli",
  "version": "0.3.0",
  "description": "The open checker and page of delurio-graph/0: check every graph in a project's own CI, offline, with GNU error lines and SARIF.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "delurio": "dist/cli.js" },
  "exports": {
    "./graph": { "types": "./dist/graph.d.ts", "default": "./dist/graph.js" },
    "./model": { "types": "./dist/model.d.ts", "default": "./dist/model.js" },
    "./story": { "types": "./dist/story.d.ts", "default": "./dist/story.js" },
    "./wireframe": { "types": "./dist/wireframe.d.ts", "default": "./dist/wireframe.js" },
    "./kit": { "types": "./dist/kit.d.ts", "default": "./dist/kit.js" },
    "./edges": { "types": "./dist/edges.d.ts", "default": "./dist/edges.js" },
    "./html": { "types": "./dist/html.d.ts", "default": "./dist/html.js" },
    "./nav": { "types": "./dist/nav.d.ts", "default": "./dist/nav.js" },
    "./expr": { "types": "./dist/expr.d.ts", "default": "./dist/expr.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "schemas", "SPEC.md", "NOTICE", "CHANGELOG.md"],
  "engines": { "node": ">=22.18" },
  "repository": { "type": "git", "url": "git+https://github.com/delurio-labs/delurio.git" },
  "homepage": "https://delur.io",
  "bugs": "https://github.com/delurio-labs/delurio/issues",
  "keywords": ["statechart", "graph", "spec", "checker", "sarif", "ci"],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node src/cli.ts check examples --strict"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "elkjs": "0.12.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
